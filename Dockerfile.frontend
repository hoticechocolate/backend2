FROM node:22-alpine AS build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Activate the existing data loader against the backend compatibility endpoints.
# This is a public marker, not a Supabase credential.
ENV VITE_SUPABASE_URL=/compat VITE_SUPABASE_ANON_KEY=local-public-data VITE_SUPABASE_BUCKET=sic-images VITE_API_BASE_URL=/api
RUN npm run build

FROM nginx:1.28-alpine
COPY --from=build /frontend/dist /usr/share/nginx/html
COPY backend/deploy/nginx.conf /etc/nginx/conf.d/default.conf
